
def fazer_bolo(opcao_sabor):
    if opcao_sabor == "1":
        sabor = "Chocolate"
    elif opcao_sabor == "2":
        sabor = "Baunilha"
    else:
        sabor = "Sabor Tradicional"

    print(f"1. Separe os ingredientes necessários: {sabor}, farinha, açúcar, ovos, leite, fermento e manteiga.")
    print("2. Unte a forma com manteiga.")
    print("3. Quebre 2 ovos num recipiente, adicione manteiga, açúcar e os misture bem.")
    print("4. Adicione farinha e leite aos poucos e o fermento.")
    print(f"5. Adicione o sabor escolhido: {sabor}")
    print("6. Adicione uma colher de chá de fermento e misture tudo muito bem.")
    print("7. Coloque a massa na forma e depois coloque a forma no forno e deixe assar por 30 minutos.")
    print("8. Após 30 minutos, retire o bolo do forno.")

    return f"O seu bolo de {sabor} está pronto!"


print("Escolha o sabor do bolo:")
print("1 - Chocolate")
print("2 - Baunilha")
sabor_escolhido = input("Digite o número do sabor desejado (1 ou 2): ")

status_do_bolo = fazer_bolo(sabor_escolhido)

print("\nResultado:")
print(status_do_bolo)